diff --git a/src/systems/ambient/SeagullRenderer.ts b/src/systems/ambient/SeagullRenderer.ts
new file mode 100644
index 0000000..3a180a8
--- /dev/null
+++ b/src/systems/ambient/SeagullRenderer.ts
@@ -0,0 +1,127 @@
+import {
+  BufferAttribute,
+  BufferGeometry,
+  DoubleSide,
+  DynamicDrawUsage,
+  Euler,
+  InstancedMesh,
+  Matrix4,
+  MeshStandardMaterial,
+  Quaternion,
+  Vector3,
+  type Group,
+} from 'three';
+import type { BirdPose } from './flock';
+
+const ZERO_MATRIX = new Matrix4().makeScale(0, 0, 0);
+
+/**
+ * One InstancedMesh for every gull: a body plus two wing triangles in a shallow V.
+ * Flapping squashes the instance's Y scale, which reads as wing beats from the ground
+ * and costs nothing per vertex. Local +Z is the flight direction.
+ */
+export class SeagullRenderer {
+  private readonly mesh: InstancedMesh;
+  private readonly geometry: BufferGeometry;
+  private readonly material: MeshStandardMaterial;
+  private readonly matrix = new Matrix4();
+  private readonly quat = new Quaternion();
+  private readonly euler = new Euler();
+  private readonly pos = new Vector3();
+  private readonly scale = new Vector3();
+
+  constructor(
+    private readonly root: Group,
+    capacity: number,
+    private readonly size: number,
+  ) {
+    this.geometry = gullGeometry();
+    this.material = new MeshStandardMaterial({
+      color: 0xffffff,
+      vertexColors: true,
+      roughness: 0.9,
+      metalness: 0,
+      side: DoubleSide,
+      flatShading: true,
+    });
+    this.mesh = new InstancedMesh(this.geometry, this.material, capacity);
+    this.mesh.instanceMatrix.setUsage(DynamicDrawUsage);
+    this.mesh.frustumCulled = false;
+    this.mesh.castShadow = false;
+    this.mesh.name = 'ambient-seagulls';
+    for (let i = 0; i < capacity; i++) this.mesh.setMatrixAt(i, ZERO_MATRIX);
+    this.mesh.count = capacity;
+    root.add(this.mesh);
+  }
+
+  setVisible(visible: boolean): void {
+    this.mesh.visible = visible;
+  }
+
+  /** `visibility` in [0, 1] shrinks the bird so it fades out at dusk instead of popping. */
+  write(index: number, pose: BirdPose, visibility: number): void {
+    const s = this.size * visibility;
+    this.pos.set(pose.x, pose.y, pose.z);
+    this.quat.setFromEuler(this.euler.set(0, pose.yaw, pose.bank, 'YXZ'));
+    this.scale.set(s, s * pose.flap, s);
+    this.matrix.compose(this.pos, this.quat, this.scale);
+    this.mesh.setMatrixAt(index, this.matrix);
+  }
+
+  commit(): void {
+    this.mesh.instanceMatrix.needsUpdate = true;
+  }
+
+  dispose(): void {
+    this.root.remove(this.mesh);
+    this.mesh.dispose();
+    this.geometry.dispose();
+    this.material.dispose();
+  }
+}
+
+/** Body, tail and two wings (with darker tips) as a single non-indexed geometry. */
+function gullGeometry(): BufferGeometry {
+  const WHITE: [number, number, number] = [0.96, 0.96, 0.94];
+  const GREY: [number, number, number] = [0.55, 0.58, 0.62];
+  const BEAK: [number, number, number] = [0.95, 0.7, 0.2];
+  type Vertex = { p: [number, number, number]; c: [number, number, number] };
+  const tris: Vertex[][] = [
+    // Body (a flat diamond) with a small beak.
+    [
+      { p: [0, 0.08, 0.5], c: BEAK },
+      { p: [-0.14, 0.04, -0.05], c: WHITE },
+      { p: [0.14, 0.04, -0.05], c: WHITE },
+    ],
+    [
+      { p: [-0.14, 0.04, -0.05], c: WHITE },
+      { p: [0, 0.02, -0.45], c: WHITE },
+      { p: [0.14, 0.04, -0.05], c: WHITE },
+    ],
+    // Left wing: root, tip, trailing edge.
+    [
+      { p: [-0.1, 0.05, 0.22], c: WHITE },
+      { p: [-1.3, 0.32, -0.12], c: GREY },
+      { p: [-0.1, 0.03, -0.28], c: WHITE },
+    ],
+    // Right wing mirrored.
+    [
+      { p: [0.1, 0.05, 0.22], c: WHITE },
+      { p: [0.1, 0.03, -0.28], c: WHITE },
+      { p: [1.3, 0.32, -0.12], c: GREY },
+    ],
+  ];
+  const positions: number[] = [];
+  const colors: number[] = [];
+  for (const tri of tris) {
+    for (const v of tri) {
+      positions.push(...v.p);
+      colors.push(...v.c);
+    }
+  }
+  const geometry = new BufferGeometry();
+  geometry.setAttribute('position', new BufferAttribute(new Float32Array(positions), 3));
+  geometry.setAttribute('color', new BufferAttribute(new Float32Array(colors), 3));
+  geometry.computeVertexNormals();
+  return geometry;
+}
