+/**
+ * Ambient-life tunables. Units: meters, seconds, radians.
+ * +X is east, +Z is south (see src/data/districts.ts); the ocean surrounds the island.
+ */
+export const AmbientConfig = {
+  seagulls: {
+    /** Flock anchors sit just off the shoreline: the beach (east), the port (north) and the docks (south). */
+    flocks: [
+      { x: 925, z: -420, birds: 6 },
+      { x: 930, z: 0, birds: 7 },
+      { x: 925, z: 420, birds: 6 },
+      { x: -250, z: -905, birds: 6 },
+      { x: -350, z: 905, birds: 6 },
+    ],
+    orbitRadius: [22, 55],
+    /** Height above the water surface. */
+    height: [16, 34],
+    /** Tangential cruise speed (m/s); converted to angular speed per orbit radius. */
+    speed: [5, 8],
+    /** Wing beats per second while cruising. */
+    flapRate: [2.5, 4],
+    /** Uniform scale of the bird mesh (the base wingspan is about 2.5 m). */
+    size: 1.4,
+    /** Birds fade out as `night01` goes from `nightFadeStart` to `nightFadeEnd`. */
+    nightFadeStart: 0.55,
+    nightFadeEnd: 0.85,
+    /** Skip all work when the camera is farther than this from every flock. */
+    renderDistance: 480,
+    /** A shot within this radius of a flock anchor scatters it. */
+    gunshotScareRadius: 70,
+    explosionScareRadius: 180,
+    /** Seconds a scatter takes to settle back into a calm orbit. */
+    scareSeconds: 7,
+    /** Extra altitude and orbit growth at full scare. */
+    scareLift: 26,
+    scareRadiusGrowth: 1.6,
+    scareSpeedBoost: 1.3,
+  },
+} as const;
diff --git a/src/systems/ambient/flock.ts b/src/systems/ambient/flock.ts
new file mode 100644
index 0000000..6b33820
--- /dev/null
+++ b/src/systems/ambient/flock.ts
@@ -0,0 +1,122 @@
+/**
+ * Pure flock math (no Three.js) so it can be unit-tested. Each bird orbits its flock
+ * anchor on a horizontal circle; a "scare" widens, lifts and speeds up the orbit and
+ * then decays back to a calm cruise.
+ */
+
+export interface FlockTuning {
+  orbitRadius: readonly [number, number];
+  height: readonly [number, number];
+  speed: readonly [number, number];
+  flapRate: readonly [number, number];
+  scareSeconds: number;
+  scareLift: number;
+  scareRadiusGrowth: number;
+  scareSpeedBoost: number;
+}
+
+export interface Bird {
+  angle: number;
+  /** Radians per second; the sign is the orbit direction. */
+  omega: number;
+  radius: number;
+  height: number;
+  flapPhase: number;
+  flapRate: number;
+  bobPhase: number;
+}
+
+export interface Flock {
+  x: number;
+  z: number;
+  /** World Y of the water surface the heights are measured from. */
+  baseY: number;
+  /** 1 right after a scare, decays to 0. */
+  scare: number;
+  birds: Bird[];
+}
+
+export interface BirdPose {
+  x: number;
+  y: number;
+  z: number;
+  /** Rotation about +Y so the bird's local +Z points along its flight direction. */
+  yaw: number;
+  /** Roll into the turn (radians). */
+  bank: number;
+  /** Wing-height multiplier (about 0.45 to 1.5). */
+  flap: number;
+}
+
+/** Minimal RNG contract so tests can pass a deterministic stub. */
+export interface FlockRng {
+  range(min: number, max: number): number;
+  sign(): number;
+}
+
+export function createFlock(x: number, z: number, count: number, baseY: number, tuning: FlockTuning, rng: FlockRng): Flock {
+  const direction = rng.sign();
+  const birds: Bird[] = [];
+  for (let i = 0; i < count; i++) {
+    const radius = rng.range(tuning.orbitRadius[0], tuning.orbitRadius[1]);
+    const speed = rng.range(tuning.speed[0], tuning.speed[1]);
+    birds.push({
+      angle: rng.range(0, Math.PI * 2),
+      // The whole flock circles the same way, with the odd bird going against the grain.
+      omega: (direction * (rng.range(0, 1) < 0.85 ? 1 : -1) * speed) / radius,
+      radius,
+      height: rng.range(tuning.height[0], tuning.height[1]),
+      flapPhase: rng.range(0, Math.PI * 2),
+      flapRate: rng.range(tuning.flapRate[0], tuning.flapRate[1]),
+      bobPhase: rng.range(0, Math.PI * 2),
+    });
+  }
+  return { x, z, baseY, scare: 0, birds };
+}
+
+/** Smooth 0..1 easing of the scare level. */
+export function scareEase(scare: number): number {
+  const s = Math.min(1, Math.max(0, scare));
+  return s * s * (3 - 2 * s);
+}
+
+export function scareFlock(flock: Flock): void {
+  flock.scare = 1;
+}
+
+export function stepFlock(flock: Flock, dt: number, tuning: FlockTuning): void {
+  if (flock.scare > 0) flock.scare = Math.max(0, flock.scare - dt / tuning.scareSeconds);
+  const s = scareEase(flock.scare);
+  const speedBoost = 1 + s * (tuning.scareSpeedBoost - 1);
+  for (const b of flock.birds) {
+    b.angle += b.omega * speedBoost * dt;
+    b.flapPhase += b.flapRate * (1 + s) * dt * Math.PI * 2;
+  }
+}
+
+/** Writes the pose of `bird` into `out` for the flock's current state. */
+export function poseOf(flock: Flock, bird: Bird, tuning: FlockTuning, out: BirdPose): BirdPose {
+  const s = scareEase(flock.scare);
+  const radius = bird.radius * (1 + s * (tuning.scareRadiusGrowth - 1));
+  const sin = Math.sin(bird.angle);
+  const cos = Math.cos(bird.angle);
+  out.x = flock.x + cos * radius;
+  out.z = flock.z + sin * radius;
+  out.y = flock.baseY + bird.height + s * tuning.scareLift + Math.sin(bird.angle * 2 + bird.bobPhase) * 1.2;
+  const dir = bird.omega >= 0 ? 1 : -1;
+  // d/dθ of (cos, sin) is (-sin, cos); flip for clockwise orbits.
+  const fx = -sin * dir;
+  const fz = cos * dir;
+  out.yaw = Math.atan2(fx, fz);
+  out.bank = -dir * (0.3 - 0.15 * s);
+  // Gliding is a gentle shimmer; a scatter is full wing beats.
+  out.flap = 0.95 + (0.08 + 0.42 * s) * Math.sin(bird.flapPhase);
+  return out;
+}
+
+/** 1 in daylight, 0 at night, linear between the two thresholds. */
+export function nightVisibility(night01: number, fadeStart: number, fadeEnd: number): number {
+  if (night01 <= fadeStart) return 1;
+  if (night01 >= fadeEnd) return 0;
+  return 1 - (night01 - fadeStart) / (fadeEnd - fadeStart);
+}
diff --git a/src/systems/ambient/index.ts b/src/systems/ambient/index.ts
new file mode 100644
index 0000000..89facfa
--- /dev/null
+++ b/src/systems/ambient/index.ts
@@ -0,0 +1,119 @@
+import { Config } from '../../core/Config';
+import type { V3 } from '../../core/entities';
+import type { Game } from '../../core/Game';
+import { Random } from '../../core/Random';
+import { PRIORITY, type GameSystem, type SystemModule } from '../../core/System';
+import { AmbientConfig } from './config';
+import { createFlock, nightVisibility, poseOf, scareFlock, stepFlock, type BirdPose, type Flock } from './flock';
+import { SeagullRenderer } from './SeagullRenderer';
+
+const G = AmbientConfig.seagulls;
+
+/**
+ * Cosmetic world life that no other system owns. Today: seagull flocks circling the
+ * shoreline by day. They scatter on gunfire and explosions, fade out at dusk and cost
+ * one draw call. Nothing here is saved or affects gameplay.
+ */
+export class AmbientSystem implements GameSystem {
+  private flocks: Flock[] = [];
+  private renderer: SeagullRenderer | null = null;
+  private readonly offs: Array<() => void> = [];
+  private readonly pose: BirdPose = { x: 0, y: 0, z: 0, yaw: 0, bank: 0, flap: 1 };
+
+  constructor(private readonly game: Game) {}
+
+  init(): void {
+    const rng = Random.fromString('leonida-ambient-seagulls');
+    const baseY = Config.world.waterLevel;
+    let total = 0;
+    for (const f of G.flocks) {
+      this.flocks.push(createFlock(f.x, f.z, f.birds, baseY, G, rng));
+      total += f.birds;
+    }
+    this.renderer = new SeagullRenderer(this.game.worldRoot, total, G.size);
+
+    const ev = this.game.events;
+    this.offs.push(
+      ev.on('weapon:fired', ({ origin }) => this.scatterNear(origin, G.gunshotScareRadius)),
+      ev.on('vehicle:exploded', ({ position }) => this.scatterNear(position, G.explosionScareRadius)),
+    );
+  }
+
+  /** Scatters every flock whose anchor is within `radius` of `at`; returns how many were scared. */
+  private scatterNear(at: V3, radius: number): number {
+    let scared = 0;
+    const r2 = radius * radius;
+    for (const flock of this.flocks) {
+      const dx = flock.x - at.x;
+      const dz = flock.z - at.z;
+      if (dx * dx + dz * dz <= r2) {
+        scareFlock(flock);
+        scared++;
+      }
+    }
+    return scared;
+  }
+
+  update(dt: number): void {
+    const renderer = this.renderer;
+    if (!renderer) return;
+    // Interiors hide the world root already; skip the math as well.
+    if (this.game.state.interior !== null) return;
+    const night = this.game.systems.has('world') ? this.game.world.night01 : 0;
+    const visibility = nightVisibility(night, G.nightFadeStart, G.nightFadeEnd);
+    if (visibility <= 0.01) {
+      renderer.setVisible(false);
+      return;
+    }
+    const cam = this.game.viewCamera.position;
+    const maxD2 = (G.renderDistance + G.orbitRadius[1] * G.scareRadiusGrowth) ** 2;
+    let nearAny = false;
+    for (const flock of this.flocks) {
+      const dx = flock.x - cam.x;
+      const dz = flock.z - cam.z;
+      if (dx * dx + dz * dz <= maxD2) {
+        nearAny = true;
+        break;
+      }
+    }
+    renderer.setVisible(nearAny);
+    if (!nearAny) return;
+
+    let index = 0;
+    for (const flock of this.flocks) {
+      stepFlock(flock, dt, G);
+      for (const bird of flock.birds) {
+        renderer.write(index++, poseOf(flock, bird, G, this.pose), visibility);
+      }
+    }
+    renderer.commit();
+    this.game.perf.set('gulls', index);
+  }
+
+  dispose(): void {
+    for (const off of this.offs) off();
+    this.offs.length = 0;
+    this.renderer?.dispose();
+    this.renderer = null;
+    this.flocks = [];
+  }
+
+  debugActions = {
+    /** `ambient.scare` scatters every flock regardless of distance. */
+    scare: (): number => {
+      for (const f of this.flocks) scareFlock(f);
+      return this.flocks.length;
+    },
+    /** `ambient.flocks` lists anchors and current scare levels. */
+    flocks: (): Array<{ x: number; z: number; birds: number; scare: number }> =>
+      this.flocks.map((f) => ({ x: f.x, z: f.z, birds: f.birds.length, scare: Number(f.scare.toFixed(2)) })),
+  };
+}
+
+const module: SystemModule = {
+  id: 'ambient',
+  priority: PRIORITY.ambient,
+  create: (game) => new AmbientSystem(game),
+};
+
+export default module;
diff --git a/tests/ambient/flock.test.ts b/tests/ambient/flock.test.ts
new file mode 100644
index 0000000..f3ede5e
--- /dev/null
+++ b/tests/ambient/flock.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from 'vitest';
+import { Random } from '../../src/core/Random';
+import { AmbientConfig } from '../../src/systems/ambient/config';
+import { createFlock, nightVisibility, poseOf, scareEase, scareFlock, stepFlock, type BirdPose } from '../../src/systems/ambient/flock';
+
+const G = AmbientConfig.seagulls;
+const pose = (): BirdPose => ({ x: 0, y: 0, z: 0, yaw: 0, bank: 0, flap: 1 });
+
+describe('seagull flocks', () => {
+  it('creates the requested number of birds inside the configured ranges', () => {
+    const flock = createFlock(100, -50, 8, 0, G, Random.fromString('t'));
+    expect(flock.birds).toHaveLength(8);
+    for (const b of flock.birds) {
+      expect(b.radius).toBeGreaterThanOrEqual(G.orbitRadius[0]);
+      expect(b.radius).toBeLessThanOrEqual(G.orbitRadius[1]);
+      expect(b.height).toBeGreaterThanOrEqual(G.height[0]);
+      expect(b.height).toBeLessThanOrEqual(G.height[1]);
+    }
+  });
+
+  it('keeps every bird on its orbit around the anchor while calm', () => {
+    const flock = createFlock(100, -50, 6, 0, G, Random.fromString('orbit'));
+    const out = pose();
+    for (let i = 0; i < 300; i++) {
+      stepFlock(flock, 1 / 60, G);
+      for (const b of flock.birds) {
+        poseOf(flock, b, G, out);
+        expect(Math.hypot(out.x - 100, out.z + 50)).toBeCloseTo(b.radius, 5);
+      }
+    }
+  });
+
+  it('points the bird along its direction of travel', () => {
+    const flock = createFlock(0, 0, 4, 0, G, Random.fromString('heading'));
+    const a = pose();
+    const b = pose();
+    for (const bird of flock.birds) {
+      poseOf(flock, bird, G, a);
+      const dt = 0.01;
+      bird.angle += bird.omega * dt;
+      poseOf(flock, bird, G, b);
+      const vx = b.x - a.x;
+      const vz = b.z - a.z;
+      expect(Math.sin(a.yaw) * vx + Math.cos(a.yaw) * vz).toBeGreaterThan(0);
+    }
+  });
+
+  it('scatters upward and outward, then settles back', () => {
+    const flock = createFlock(0, 0, 3, 0, G, Random.fromString('scare'));
+    const bird = flock.birds[0];
+    const calm = poseOf(flock, bird, G, pose());
+    const calmRadius = Math.hypot(calm.x, calm.z);
+    const calmY = calm.y;
+    scareFlock(flock);
+    const scared = poseOf(flock, bird, G, pose());
+    expect(scared.y).toBeGreaterThan(calmY + G.scareLift * 0.9);
+    expect(Math.hypot(scared.x, scared.z)).toBeGreaterThan(calmRadius * 1.4);
+    for (let i = 0; i < 60 * (G.scareSeconds + 1); i++) stepFlock(flock, 1 / 60, G);
+    expect(flock.scare).toBe(0);
+  });
+
+  it('eases the scare level monotonically within 0..1', () => {
+    let last = -1;
+    for (let i = 0; i <= 20; i++) {
+      const e = scareEase(i / 20);
+      expect(e).toBeGreaterThanOrEqual(last);
+      expect(e).toBeGreaterThanOrEqual(0);
+      expect(e).toBeLessThanOrEqual(1);
+      last = e;
+    }
+    expect(scareEase(-3)).toBe(0);
+    expect(scareEase(4)).toBe(1);
+  });
+
+  it('fades out between the night thresholds', () => {
+    expect(nightVisibility(0, G.nightFadeStart, G.nightFadeEnd)).toBe(1);
+    expect(nightVisibility(1, G.nightFadeStart, G.nightFadeEnd)).toBe(0);
+    const mid = nightVisibility((G.nightFadeStart + G.nightFadeEnd) / 2, G.nightFadeStart, G.nightFadeEnd);
+    expect(mid).toBeCloseTo(0.5);
+  });
+});
